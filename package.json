{
    "name": "gitguard",
    "private": true,
    "packageManager": "pnpm@9.2.0",
    "scripts": {
        "dev": "pnpm --dir apps/desktop dev",
        "build": "pnpm --dir apps/desktop build",
        "lint": "pnpm --dir apps/desktop lint",
        "type-check": "pnpm --dir apps/desktop type-check",
        "test": "pnpm --dir apps/desktop test && cargo test --workspace",
        "test:frontend": "pnpm --dir apps/desktop test",
        "test:rust": "cargo test --workspace",
        "tauri": "pnpm --dir apps/desktop tauri"
    }
}
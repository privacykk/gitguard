{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "GitGuard",
    "version": "0.1.0",
    "identifier": "dev.gitguard.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "GitGuard",
                "width": 900,
                "height": 650
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "targets": "all",
        "icon": []
    }
}